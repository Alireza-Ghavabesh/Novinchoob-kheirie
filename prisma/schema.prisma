datasource db {
  provider = "sqlite"
  url      = "file:./charity.db"
}

generator client {
  provider = "prisma-client-js"
}

model AppConfig {
  id                 Int      @id @default(1)
  instName           String   @default("مؤسسه خیریه حضرت ام‌البنین (س)")
  automationTitle    String   @default("سامانه اتوماسیون کادر خیریه حضرت ام‌البنین (س)")
  logoDataUrl        String?
  phone              String   @default("021-55667788")
  address            String   @default("تهران، میدان ابوذر، خیابان شهید فتحی، پلاک ۲۴")
  notice             String   @default("تمامی اطلاعات ثبت‌شده توسط مددکاران معتمد خیریه بازبینی و راستی‌آزمایی می‌گردد.")
  loginTitle         String   @default("ورود به پنل کادر خیریه")
  loginSubtitle      String   @default("")
  loginWelcomeNote   String   @default("")
  loginFooterText    String   @default("دسترسی اختصاصی کادر و مدیران مجاز مؤسسه")
  loginTheme         String   @default("emerald")
  loginBgDataUrl     String?
  loginShowLogo      Boolean  @default(true)
  loginAllowPassword Boolean  @default(true)
  loginAllowOtp      Boolean  @default(true)
  loginShowBackLink  Boolean  @default(true)
  appDomain          String   @default("")
  publicFormConfig   String   @default("")
  updatedAt          DateTime @updatedAt
}

model NeedCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model ProgramCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model BeneficiaryRequest {
  id              Int      @id @default(autoincrement())
  trackingCode    String   @unique
  name            String
  nid             String
  phone           String
  birthDate       String
  guardian        String
  dependents      Int      @default(0)
  housing         String
  cat             String
  requestedAmount Float    @default(0)
  approvedAmount  Float    @default(0)
  desc            String
  address         String
  status          String   @default("PENDING") // PENDING, APPROVED, NEEDS_INFO, REJECTED
  note            String?
  approvedDate    String?
  approvedBy      String?
  customFields    String   @default("[]")
  beneficiaryId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Program {
  id              Int          @id @default(autoincrement())
  title           String
  cat             String
  requestedBudget Float        @default(0)
  approvedBudget  Float        @default(0)
  volunteers      Int          @default(0)
  roles           String?
  desc            String
  startDate       String
  endDate         String
  status          String       @default("PENDING") // PENDING, APPROVED, NEEDS_REVISION, REJECTED
  pipelineStage   Int          @default(1) // 1 to 4
  progressPercent Int          @default(0)
  approvedDate    String?
  approvedBy      String?
  logs            ProgramLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model ProgramLog {
  id        Int      @id @default(autoincrement())
  programId Int
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  date      String
  note      String
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  phone     String?
  role      String   @default("کارشناس")
  perms     String   // JSON string of permissions
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id          Int      @id @default(autoincrement())
  username    String
  name        String?
  status      String   @default("PENDING") // PENDING, RESOLVED
  requestDate String
  note        String?
  createdAt   DateTime @default(now())
}

model SmsConfig {
  id               Int      @id @default(1)
  apiKey           String   @default("")
  senderLine       String   @default("")
  provider         String   @default("GHASEDAK") // GHASEDAK, CUSTOM
  loginOtpTemplate String   @default("")
  loginOtpMessage  String   @default("")
  isEnabled        Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model SmsRule {
  id              Int      @id @default(autoincrement())
  title           String
  eventType       String   // REQUEST_CREATED, REQUEST_STATUS_CHANGED, PROGRAM_CREATED, PROGRAM_STATUS_CHANGED, USER_LOGIN, PASSWORD_RESET
  triggerStatus   String?  // PENDING, APPROVED, NEEDS_INFO, REJECTED, ALL
  userFilter      String?  // specific user id or 'ALL'
  targetType      String   // BENEFICIARY, ADMINS, SPECIFIC_NUMBERS, PROGRAM_OWNER
  customNumbers   String?  // comma separated numbers
  templateType    String   @default("SIMPLE") // SIMPLE or OTP (Ghasedak OTP / Pattern)
  templateName    String?  // Template name or pattern id for ghasedak
  templateParam1  String?  // placeholder mapping
  templateParam2  String?
  templateParam3  String?
  messageBody     String   // text template with placeholders like {name}, {trackingCode}, {status}, {amount}, {instName}
  sendPush        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SmsLog {
  id            Int      @id @default(autoincrement())
  ruleTitle     String?
  eventType     String
  receptor      String
  message       String
  status        String   // SUCCESS, FAILED, SIMULATED
  providerMsgId String?
  cost          Int?
  errorDetails  String?
  createdAt     DateTime @default(now())
}

model PushConfig {
  id             Int      @id @default(1)
  publicKey      String   @default("")
  privateKey     String   @default("")
  contactEmail   String   @default("mailto:admin@charity.local")
  isEnabled      Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  username  String?  // username who subscribed (e.g. admin or staff)
  userAgent String?
  createdAt DateTime @default(now())
}

model OtpCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  purpose   String   @default("LOGIN") // LOGIN, PASSWORD_RESET
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

model EntityDefinition {
  id            String   @id @default(cuid())
  name          String
  singularLabel String   @default("")
  description   String   @default("")
  fields        String   @default("[]")
  catalogItems  String   @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CustomForm {
  id                      String                 @id @default(cuid())
  slug                    String                 @unique
  title                   String
  description             String                 @default("")
  heroBadge               String                 @default("بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ")
  theme                   String                 @default("emerald")
  submitButtonText        String                 @default("ثبت نهایی اطلاعات")
  successMessage          String                 @default("اطلاعات شما با موفقیت در سیستم ثبت گردید.")
  isActive                Boolean                @default(true)
  showTracking            Boolean                @default(true)
  showInBeneficiaryPortal Boolean                @default(false)
  maxFileSizeMB           Int                    @default(5)
  smsRules                String                 @default("[]")
  fields                  String                 @default("[]")
  submissions             CustomFormSubmission[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

model CustomFormSubmission {
  id              Int                 @id @default(autoincrement())
  trackingCode    String              @unique
  formId          String
  form            CustomForm          @relation(fields: [formId], references: [id], onDelete: Cascade)
  beneficiaryId   String?
  beneficiary     BeneficiaryAccount? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)
  data            String              @default("[]")
  status          String              @default("NEW") // NEW, IN_REVIEW, NEEDS_INFO, APPROVED, REJECTED, REVIEWED, ARCHIVED
  note            String?
  expertMessage   String?
  expertMessageAt DateTime?
  expertMessageBy String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model BeneficiaryAccount {
  id          String                 @id @default(cuid())
  firstName   String                 @default("")
  lastName    String                 @default("")
  fullName    String
  phone       String                 @unique
  isActive    Boolean                @default(true)
  submissions CustomFormSubmission[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}


